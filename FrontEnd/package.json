{
  "name": "hr-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prebuild.js && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build --webpack",
    "i18n:check": "node -e \"const fr=require('./src/i18n/locales/fr.json'),en=require('./src/i18n/locales/en.json'),fk=Object.keys(fr),ek=Object.keys(en),mE=fk.filter(k=>!ek.includes(k)),mF=ek.filter(k=>!fk.includes(k));if(mE.length||mF.length){if(mE.length)console.error('Missing EN:',mE);if(mF.length)console.error('Missing FR:',mF);process.exit(1)}else console.log('i18n OK:',fk.length,'keys')\"",
    "dead-code": "knip"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@google/genai": "^1.51.0",
    "@remotion/player": "4.0.465",
    "@supabase/supabase-js": "^2.99.2",
    "autoprefixer": "^10.4.24",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.575.0",
    "motion": "^12.40.0",
    "next": "^16.2.2",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.0.0",
    "remotion": "4.0.465",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^24.1.3",
    "knip": "^6.21.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vite": "^5.4.8",
    "vitest": "^1.6.0"
  }
}
