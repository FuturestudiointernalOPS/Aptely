{
  "name": "aptely-backend",
  "version": "1.0.0",
  "description": "Aptely — AI-powered recruitment platform API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=1024 nodemon",
    "build": "node scripts/prebuild.js && tsc --project tsconfig.json && tsc-alias -p tsconfig.json && cp src/openapi.yaml dist/openapi.yaml",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "type-check": "tsc --noEmit",
    "test": "cross-env jest --forceExit",
    "test:watch": "cross-env jest --watch",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true jest --forceExit",
    "dead-code": "knip",
    "ensure:demo-superadmin": "node scripts/ensure-demo-superadmin.cjs"
  },
  "keywords": [
    "aptely",
    "recruitment",
    "ai",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.59.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.2",
    "@types/pdfkit": "^0.17.6",

    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.2.0",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "resend": "^6.9.2",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "knip": "^6.21.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
